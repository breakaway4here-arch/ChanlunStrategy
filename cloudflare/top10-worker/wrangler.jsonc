{
  "name": "top10-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "TOP10_KV",
      "id": "9ac3f37ffcb34dfab4569f68da3fab55"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DECISION_WATCHLIST",
        "class_name": "DecisionWatchlist"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-decision-watchlist",
      "new_sqlite_classes": ["DecisionWatchlist"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://breakaway4here-arch.github.io",
    "GITHUB_OWNER": "breakaway4here-arch",
    "GITHUB_REPO": "ChanlunStrategy",
    "GITHUB_WORKFLOW_ID": "top10-on-demand.yml",
    "GITHUB_REF": "main"
  }
}
